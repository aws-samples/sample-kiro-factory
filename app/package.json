{
  "name": "loop-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A canvas of agent loops. Drag loops, wire them together, press start.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite build && node --experimental-strip-types server/index.ts",
    "start": "node --experimental-strip-types server/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "dompurify": "3.4.14",
    "highlight.js": "11.11.1",
    "marked": "15.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.5.4",
    "vite": "8.2.2"
  }
}
